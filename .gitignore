# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Django
*.log
# db.sqlite3 is intentionally TRACKED so the deployed site ships
# with your movies and superuser. Edit data LOCALLY and push;
# changing it on the server too will cause merge conflicts.
db.sqlite3-journal
local_settings.py

# collectstatic output (regenerated on the server)
staticfiles/

# Virtual environments
venv/
venv312/
.venv/
env/

# Environment variables (never commit credentials)
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# NOTE: media/ is deliberately NOT ignored. Uploaded movie posters are
# tracked so they deploy with the code. Remove this exception if you
# ever switch to proper file storage.
